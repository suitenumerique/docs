docker_build(
    'localhost:5001/impress-yhub:latest',
    context='..',
    dockerfile='../src/yhub-server/Dockerfile',
    only=['./src/yhub-server', './docker', './.dockerignore'],
    target = 'yhub',
    build_args={'DOCKER_USER': '1000:1000'},
    live_update=[
        sync('../src/yhub-server', '/app'),
