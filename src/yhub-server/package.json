{
  "name": "yhub-server",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import ./dist/sentry.js dist/server.js",
    "dev": "nodemon --config nodemon.json",
    "init-db": "node node_modules/@y/hub/bin/init-db.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@sentry/node": "11.10.0",
    "@sentry/profiling-node": "11.10.0",
    "@y/hub": "0.10.1",
    "@y/y": "14.0.0-rc.29",
    "jose": "6.2.14",
    "lru-cache": "11.5.3",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "nodemon": "3.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "decode-uri-component": "0.5.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "yarn@1.22.22"
}
